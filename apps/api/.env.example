# ============================================================
#  VPS 转售面板 —— 配置文件模板
#
#  用法：把这个文件复制成 .env，然后按下面的说明逐项填。
#        用 Docker Compose 部署的话不用管这个文件，改根目录的 .env 就行。
#
#  带「必填」的项目不填程序起不来；其余的可以先留着默认值。
# ============================================================

# ---------- 数据库（必填） ----------
# 格式：mysql://用户名:密码@主机:端口/库名
# Docker Compose 部署时主机名就写 mysql，不要写 127.0.0.1
DATABASE_URL="mysql://vps:改成你的数据库密码@127.0.0.1:3306/vps_resale"

# ---------- Redis（必填） ----------
# 建机任务队列用。Docker Compose 部署时主机名写 redis
REDIS_URL="redis://127.0.0.1:6379"

# ---------- 服务端口 ----------
PORT=3000

# 面板对外的完整地址，带 https://，结尾不要斜杠。
# 支付回调和支付完成后的跳转都基于它拼出来，填错了付款回不来。
PUBLIC_BASE_URL="https://你的域名"

# ---------- 安全（必填，两个都要改） ----------
# 登录令牌的签名密钥。随便一串长随机字符，泄露了别人就能伪造登录。
# 生成办法：openssl rand -base64 48
JWT_SECRET="改成一串很长的随机字符串"
JWT_EXPIRES_IN="7d"

# 凭据加密密钥，至少 32 个字符。
# 你的谷歌云密钥、AWS 密钥、每台机器的 SSH 密码都用它加密后才入库。
#
# ⚠️ 一旦库里存过数据，这个值就不能再改。改了之前存的东西全部解不开。
#    生成办法：openssl rand -base64 48
CREDENTIALS_SECRET="改成一串至少32位的随机字符串"

# ---------- 第一个管理员账号 ----------
# 程序第一次启动时会自动创建这个账号。建完之后建议把密码改掉。
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="改成你自己的密码"

# ---------- 防刷单闸门 ----------
# 「下单即开」是真花钱的：用户每买一台，你的云账单就多一台。
# 下面三个值是防止有人恶意刷单把你账单刷爆的闸门，别关掉。

# 单个用户最多能同时持有多少台在跑的机器
MAX_ACTIVE_SERVICES_PER_USER=5
# 全平台每天最多自动创建多少台机器
MAX_DAILY_PROVISION=50
# 未付款订单多少分钟后自动取消（同时释放被锁定的库存）
ORDER_EXPIRE_MINUTES=30

# ---------- 建机行为 ----------
# 建完机等 SSH 通的最长时间（秒）。谷歌云一般 40 秒内，Lightsail 一般 60 秒内。
PROVISION_SSH_TIMEOUT=240
# 建机失败后自动重试几次
PROVISION_MAX_ATTEMPTS=3
# 建机失败时是否自动销毁半成品实例（强烈建议开着，否则会留下计费的僵尸机器）
PROVISION_ROLLBACK_ON_FAIL=true

# ---------- 交付给用户的默认设置 ----------
# 卖出去的机器默认用哪个用户名登录
DEFAULT_SSH_USER="root"
# 建机时是否自动开启 BBR 加速（这是你的「优化」卖点之一）
ENABLE_BBR_ON_PROVISION=true

# ---------- 支付：Jeepay ----------
# 支付通道也能在后台页面里配，这里填了的话程序第一次启动会自动建好通道。
JEEPAY_GATEWAY_URL=""
JEEPAY_MCH_NO=""
JEEPAY_APP_ID=""
JEEPAY_APP_SECRET=""
# 各币种走哪个支付方式码，问你的 Jeepay 服务商要
JEEPAY_WAY_CODE_CNY=""
JEEPAY_WAY_CODE_USD=""
# 部分通道以第三方币种结算时的换算率，用不到就留空
JEEPAY_CNY_TO_KHR_RATE=""
JEEPAY_USD_TO_CNY_RATE=""

# ---------- 支付：TokenPay（USDT，可选） ----------
TOKENPAY_API_TOKEN=""

# ---------- 日志 ----------
# debug 会打印每一次云厂商 API 调用，排查建机失败时打开
LOG_LEVEL="log"
