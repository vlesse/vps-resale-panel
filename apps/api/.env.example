# ----- Database -----
# MySQL connection string. Prisma uses this directly.
DATABASE_URL="mysql://vps:vps_pass@127.0.0.1:3306/vps_resale"

# ----- App -----
PORT=3000
APP_BASE_URL="http://127.0.0.1:3000"
# Optional, used by some absolute URLs/notifications. Falls back to APP_BASE_URL.
PUBLIC_BASE_URL="http://127.0.0.1:3000"

# ----- Security -----
# JWT signing secret (use a long random string in production).
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# AES-256-GCM key (sha256 of this string) used to encrypt inventory &
# pay-channel credentials at rest. Must be >= 32 chars and must NOT change
# after data is written (you'd lose the ability to decrypt existing rows).
CREDENTIALS_SECRET="32-char-minimum-secret-key!!!!!!"

# ----- Admin bootstrap -----
# On first boot, if no user exists with this email, an admin is created.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"

# ----- Jeepay (aggregated payment gateway) -----
JEEPAY_GATEWAY_URL="https://pay.example.com"
JEEPAY_MCH_NO=""
JEEPAY_APP_ID=""
JEEPAY_APP_SECRET=""
# Per-currency wayCode mappings configured on your Jeepay merchant account.
JEEPAY_WAY_CODE_CNY="ABA_KHQR"
JEEPAY_WAY_CODE_USD="PP_PC"
# ABA PayWay (card) channel - currency + rate relative to CNY list price.
JEEPAY_ABA_PC_CURRENCY="USD"
JEEPAY_ABA_PC_CNY_RATE="0.14"
# Rates used by the panel to convert list prices for the gateway.
JEEPAY_CNY_TO_KHR_RATE="560"
JEEPAY_USD_TO_CNY_RATE="7.2"
# Public URLs Jeepay redirects/notify-s back to. Must be reachable from the gateway.
JEEPAY_NOTIFY_URL="http://127.0.0.1:3000/api/payments/jeepay/notify"
JEEPAY_RETURN_URL="http://127.0.0.1:3000/pay/result.html"

# ----- TokenPay (optional USDT/crypto gateway) -----
# Leave empty to disable. When set, the crypto channel uses TokenPay instead of Jeepay.
TOKENPAY_API_TOKEN=""
TOKENPAY_NOTIFY_URL=""

# ----- Pay channels shown on checkout -----
# Comma-separated codes; must match rows seeded by prisma/seed-pay-channels.js
PAY_METHODS_ENABLED="aba_khqr,aba_pc,crypto"
