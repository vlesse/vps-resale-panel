// ============================================================
//  多云 VPS 转售面板 —— 数据模型
//
//  与上一代模型最大的不同：不再区分「库存机」和「云实例」两套东西。
//  统一成一张 Machine 表，靠 Plan.fulfillment 决定它什么时候被创建：
//
//    on_demand  付款后调云厂商 API 现建 → 这时才写 Machine 行
//    inventory  你提前建好机器写进 Machine（ready）→ 下单时分配
//
//  这样开机/关机/重启/改密/重装/销毁对两种履约方式是同一条代码路径。
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

/// 驱动类型。前两个能自己创建机器，后两个只能操作已存在的机器。
enum ProviderKind {
  gcp // 谷歌云 Compute Engine
  lightsail // AWS Lightsail
  ssh // 任意能 SSH 进去的机器（自有 / 其它上游）
  proxmox // 自建 Proxmox VE 虚拟机
}

/// 套餐怎么履约
enum Fulfillment {
  on_demand // 付款后现调 API 建机
  inventory // 从 ready 库存池里分配一台
}

enum UserRole {
  customer
  admin
}

enum UserStatus {
  active
  blocked
}

enum CurrencyCode {
  CNY
  USD
}

enum BillingCycle {
  monthly
  quarterly
  yearly
}

/// 机器生命周期。前四个只有库存模式会经历。
enum MachineStatus {
  sourcing // 采购中
  optimizing // 优化中（装 BBR、调线路、装组件）
  ready // 待售
  reserved // 已被某张订单锁定，等付款
  provisioning // 正在向云厂商创建
  running // 已交付，开机中
  stopped // 已交付，关机中
  rebuilding // 重装中
  suspended // 停用（到期 / 欠费 / 违规）
  releasing // 正在销毁
  released // 已销毁，行只作历史留存
  error // 出错，需人工介入
}

enum OrderKind {
  new // 新购
  renew // 续费
}

enum OrderStatus {
  pending_payment
  paid
  provisioning
  completed
  cancelled
  refunded
  failed
}

enum PaymentStatus {
  pending
  success
  failed
}

enum ServiceStatus {
  provisioning
  active
  stopped
  suspended
  expired
  cancelled
  error
}

enum ServiceActionType {
  status_check
  start
  stop
  reboot
  reset_password
  rebuild
  sync_metrics
}

enum ServiceActionStatus {
  queued
  running
  success
  failed
}

enum JobStatus {
  queued
  running
  success
  failed
}

enum JobKind {
  provision // 建机 + 交付
  rebuild // 重装
  release // 销毁
}

// ---------- 账号 ----------

model User {
  id              BigInt     @id @default(autoincrement())
  email           String     @unique @db.VarChar(191)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  displayName     String?    @map("display_name") @db.VarChar(64)
  phone           String?    @db.VarChar(32)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  role            UserRole   @default(customer)
  status          UserStatus @default(active)

  /// 反刷单闸门：该用户最多能同时持有多少台在跑的机器。0 = 用全局默认值。
  maxActiveServices Int @default(0) @map("max_active_services")

  /// 上次改密码的时间。
  ///
  /// 令牌是无状态的，改完密码旧令牌照样能用到过期为止（7 天）——
  /// 那样「重置密码」就踢不掉任何人，等于半个功能。签发时间早于这个值的
  /// 令牌一律拒掉，改密码才真的意味着「把别的地方都请出去」。
  passwordChangedAt DateTime? @map("password_changed_at")

  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  /// 账户余额，单位分，币种见 WALLET_CURRENCY（默认人民币）。
  ///
  /// 这里存的是**快照**，真相在 wallet_txs 那张流水表里 ——
  /// 任何一次加减都必须同时写一条流水，对不上就是有 bug。
  /// 单独放一个字段是为了下单时能用一条带条件的 UPDATE 原子扣款，
  /// 不然并发下单会把余额扣成负数。
  balanceCents Int @default(0) @map("balance_cents")

  orders   Order[]
  services Service[]
  logs     OperationLog[]
  walletTxs      WalletTx[]
  rechargeOrders RechargeOrder[]

  @@map("users")
}

// ---------- 你的云账号 ----------

/// 运营方自己在各云厂商的账号凭据。支持一家云挂多个账号（多项目 / 多区域配额）。
/// credentialsEncrypted 是 AES-256-GCM 密文，明文形状随 provider 不同：
///   gcp       { "projectId": "...", "serviceAccountKey": { ...JSON 全文... } }
///   lightsail { "accessKeyId": "...", "secretAccessKey": "...", "region": "ap-southeast-1" }
///   proxmox   { "host": "10.0.0.5", "node": "pve", "tokenId": "root@pam!panel", "tokenSecret": "..." }
///   ssh       不需要账号，凭据直接挂在每台 Machine 上
model CloudAccount {
  id                   BigInt       @id @default(autoincrement())
  name                 String       @db.VarChar(120)
  provider             ProviderKind
  credentialsEncrypted String       @map("credentials_encrypted") @db.Text
  defaultRegion        String?      @map("default_region") @db.VarChar(64)

  /// 该账号每天最多允许创建多少台机器，防止刷单烧云账单。
  dailyCreateQuota Int @default(20) @map("daily_create_quota")

  isEnabled      Boolean   @default(true) @map("is_enabled")
  lastCheckedAt  DateTime? @map("last_checked_at")
  lastCheckError String?   @map("last_check_error") @db.VarChar(500)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plans    Plan[]
  machines Machine[]

  @@index([provider, isEnabled])
  @@map("cloud_accounts")
}

// ---------- 商品 ----------

model Plan {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(120)

  provider    ProviderKind
  fulfillment Fulfillment  @default(on_demand)

  /// on_demand 必填；inventory 留空（机器凭据挂在 Machine 上）
  cloudAccountId BigInt? @map("cloud_account_id")

  /// 建机参数，形状随 provider 不同。见 docs/03-接入谷歌云.md 与 docs/04-接入-AWS-Lightsail.md
  ///   gcp       { zone, machineType, sourceImage, diskGb, diskType, staticIp }
  ///   lightsail { availabilityZone, bundleId, blueprintId, staticIp }
  ///   proxmox   { templateVmid, storage, bridge }
  providerSpecJson Json? @map("provider_spec_json")

  /// inventory 模式下从库存池挑机器的筛选条件
  ///   { regions: [...], minCpu: 2, minMemoryMb: 2048, tagsAny: [...] }
  matchRulesJson Json? @map("match_rules_json")

  // 对外展示的规格
  regionLabel    String  @map("region_label") @db.VarChar(64)
  cpu            Int
  memoryMb       Int     @map("memory_mb")
  diskGb         Int     @map("disk_gb")
  trafficGb      Int?    @map("traffic_gb")
  bandwidthLabel String? @map("bandwidth_label") @db.VarChar(64)
  osTemplate     String? @map("os_template") @db.VarChar(64)
  description    String? @db.Text
  featuresJson   Json?   @map("features_json")

  /// 选购页的分栏。同一个 categoryKey 的套餐归到一栏，比如 hk / tw / kr / us。
  /// 留空的套餐会归到「其它」一栏，所以老数据不会丢。
  categoryKey   String? @map("category_key") @db.VarChar(32)
  categoryLabel String? @map("category_label") @db.VarChar(64)
  categorySort  Int     @default(0) @map("category_sort")

  /// 自定义档：不是一个固定规格，而是让用户自己选核心 / 内存 / 硬盘，价格按公式算。
  /// isCustom=true 时 cpu / memoryMb / diskGb 三个字段存的是「默认选中值」。
  /// customConfigJson 的形状：
  ///   {
  ///     cpuOptions: [2,4,8],
  ///     memoryPerCpu: { minGb: 1, maxGb: 8, stepGb: 1 },
  ///     disk: { minGb: 20, maxGb: 500, stepGb: 10 },
  ///     machineFamily: "e2",
  ///     price: { CNY: { baseCents, perCpuCents, perGbRamCents, perGbDiskCents }, USD: {...} }
  ///   }
  isCustom         Boolean @default(false) @map("is_custom")
  customConfigJson Json?   @map("custom_config_json")

  /// 该套餐最多卖出多少台在跑的机器，卖满即显示无货。0 = 不限。
  capacityLimit Int @default(0) @map("capacity_limit")

  isEnabled Boolean  @default(true) @map("is_enabled")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cloudAccount CloudAccount? @relation(fields: [cloudAccountId], references: [id])
  prices       PlanPrice[]
  orders       Order[]
  services     Service[]
  machines     Machine[]

  @@index([isEnabled, sortOrder])
  @@map("plans")
}

model PlanPrice {
  id         BigInt       @id @default(autoincrement())
  planId     BigInt       @map("plan_id")
  cycle      BillingCycle @default(monthly)
  currency   CurrencyCode
  priceCents Int          @map("price_cents")
  isEnabled  Boolean      @default(true) @map("is_enabled")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  plan   Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([planId, cycle, currency])
  @@map("plan_prices")
}

// ---------- 机器 ----------

/// 一台真实机器。按需模式下由建机任务写入，库存模式下由管理员提前录入。
model Machine {
  id             BigInt       @id @default(autoincrement())
  code           String       @unique @db.VarChar(64)
  provider       ProviderKind
  cloudAccountId BigInt?      @map("cloud_account_id")
  planId         BigInt?      @map("plan_id")

  /// 在云厂商那边的身份，用来发后续指令。形状随 provider 不同：
  ///   gcp       { projectId, zone, instanceName, staticIpName? }
  ///   lightsail { region, instanceName, staticIpName? }
  ///   proxmox   { node, vmid }
  ///   ssh       {}（靠下面的 ip / sshPort 定位）
  providerRefJson Json? @map("provider_ref_json")

  /// AES-256-GCM 密文。明文 { sshUser, sshPort, password?, privateKey? }
  authPayloadEncrypted String? @map("auth_payload_encrypted") @db.Text

  ip         String? @db.VarChar(64)
  ipv6       String? @db.VarChar(128)
  sshPort    Int     @default(22) @map("ssh_port")
  region     String  @db.VarChar(64)
  cpu        Int
  memoryMb   Int     @map("memory_mb")
  diskGb     Int     @map("disk_gb")
  osTemplate String? @map("os_template") @db.VarChar(64)

  /// 库存模式的优化标签 ["bbr","cn2-gia","warp"]
  optimizeTagsJson Json? @map("optimize_tags_json")

  status MachineStatus @default(sourcing)

  /// 乐观锁。分配库存时用 updateMany(where:{version}) 保证不超卖。
  version Int @default(0)

  costCents        Int?          @map("cost_cents")
  costCurrency     CurrencyCode? @default(CNY) @map("cost_currency")
  upstreamExpireAt DateTime?     @map("upstream_expire_at")

  lastStatusJson Json?     @map("last_status_json")
  lastCheckedAt  DateTime? @map("last_checked_at")
  lastError      String?   @map("last_error") @db.VarChar(500)
  releasedAt     DateTime? @map("released_at")
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cloudAccount CloudAccount?  @relation(fields: [cloudAccountId], references: [id])
  plan         Plan?          @relation(fields: [planId], references: [id])
  service      Service?
  jobs         ProvisionJob[]
  natBinding   NatBinding?

  @@index([status, region])
  @@index([planId, status])
  @@index([upstreamExpireAt])
  @@map("machines")
}

// ---------- 交易 ----------

model Order {
  id          BigInt       @id @default(autoincrement())
  orderNo     String       @unique @map("order_no") @db.VarChar(64)
  kind        OrderKind    @default(new)
  userId      BigInt       @map("user_id")
  planId      BigInt       @map("plan_id")
  planPriceId BigInt       @map("plan_price_id")
  cycle       BillingCycle @default(monthly)
  amountCents Int          @map("amount_cents")
  currency    CurrencyCode
  status      OrderStatus  @default(pending_payment)

  /// 续费订单指向被续费的服务
  renewServiceId BigInt? @map("renew_service_id")

  /// 自定义档下单时用户选的规格 { cpu, memoryMb, diskGb }。
  /// 固定套餐为空。建机时它会覆盖套餐里的 machineType 和 diskGb ——
  /// 必须落库，否则重装的时候就不知道该按什么规格重建了。
  customSpecJson Json? @map("custom_spec_json")

  payChannel   String?   @map("pay_channel") @db.VarChar(32)
  // 最后一次提交给网关的商户单号，以及网关给的支付单号。
  // 两个都得存：回调丢了的时候，只有靠它们才能回头问网关这笔到底收到没有。
  gatewayOrderNo String? @map("gateway_order_no") @db.VarChar(80)
  upstreamNo     String? @map("upstream_no") @db.VarChar(64)
  paidAt       DateTime? @map("paid_at")
  expiresAt    DateTime? @map("expires_at") // 未付款订单的自动取消时间
  failReason   String?   @map("fail_reason") @db.VarChar(500)
  clientRemark String?   @map("client_remark") @db.VarChar(255)
  adminRemark  String?   @map("admin_remark") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id])
  plan      Plan           @relation(fields: [planId], references: [id])
  planPrice PlanPrice      @relation(fields: [planPriceId], references: [id])
  payments  Payment[]
  service   Service?
  jobs      ProvisionJob[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  orderId       BigInt        @map("order_id")
  paymentNo     String        @unique @map("payment_no") @db.VarChar(64)
  channel       String        @db.VarChar(32)
  wayCode       String?       @map("way_code") @db.VarChar(32)
  amountCents   Int           @map("amount_cents")
  currency      CurrencyCode
  status        PaymentStatus @default(pending)
  upstreamNo    String?       @map("upstream_no") @db.VarChar(64)
  rawNotifyJson Json?         @map("raw_notify_json")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// ---------- 交付后 ----------

model Service {
  id        BigInt @id @default(autoincrement())
  serviceNo String @unique @map("service_no") @db.VarChar(64)
  userId    BigInt @map("user_id")
  orderId   BigInt @unique @map("order_id")
  planId    BigInt @map("plan_id")

  /// 建机成功后才有值；provisioning 阶段为空
  machineId BigInt? @unique @map("machine_id")

  status   ServiceStatus @default(provisioning)
  startAt  DateTime?     @map("start_at")
  expireAt DateTime      @map("expire_at")

  /// 给用户看的交付信息 { ip, sshPort, username, password, osTemplate, region }
  deliverPayloadJson Json? @map("deliver_payload_json")

  /// 最近一次拉到的运行数据 { power, cpuPercent, memUsedMb, diskUsedGb, uptimeSec, netIn, netOut }
  lastStatusJson Json?     @map("last_status_json")
  lastCheckedAt  DateTime? @map("last_checked_at")

  suspendReason String?  @map("suspend_reason") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id])
  order   Order           @relation(fields: [orderId], references: [id])
  plan    Plan            @relation(fields: [planId], references: [id])
  machine Machine?        @relation(fields: [machineId], references: [id])
  actions ServiceAction[]
  jobs    ProvisionJob[]

  @@index([userId, status])
  @@index([expireAt, status])
  @@map("services")
}

model ServiceAction {
  id           BigInt              @id @default(autoincrement())
  serviceId    BigInt              @map("service_id")
  actorType    String              @map("actor_type") @db.VarChar(16) // user | admin | system
  actorId      BigInt?             @map("actor_id")
  action       ServiceActionType
  status       ServiceActionStatus @default(queued)
  requestJson  Json?               @map("request_json")
  resultJson   Json?               @map("result_json")
  errorMessage String?             @map("error_message") @db.VarChar(500)
  createdAt    DateTime            @default(now()) @map("created_at")
  finishedAt   DateTime?           @map("finished_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt])
  @@map("service_actions")
}

/// 异步建机 / 重装 / 销毁任务。云厂商建一台机要 30-90 秒，不能让用户干等，
/// 所以订单付款成功只负责入队，真正的活在 BullMQ worker 里干，前端轮询这张表。
model ProvisionJob {
  id        BigInt    @id @default(autoincrement())
  kind      JobKind
  status    JobStatus @default(queued)
  orderId   BigInt?   @map("order_id")
  serviceId BigInt?   @map("service_id")
  machineId BigInt?   @map("machine_id")

  attempt     Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")

  /// 云厂商返回的长操作句柄，用来轮询进度
  ///   gcp       { operationName, zone }
  ///   lightsail { operationId }
  upstreamOpJson Json? @map("upstream_op_json")

  /// 进度百分比与当前步骤文字，直接给前端显示
  progress Int     @default(0)
  step     String? @db.VarChar(120)

  payloadJson Json?     @map("payload_json")
  resultJson  Json?     @map("result_json")
  lastError   String?   @map("last_error") @db.VarChar(1000)
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order   Order?   @relation(fields: [orderId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  machine Machine? @relation(fields: [machineId], references: [id])

  @@index([status, createdAt])
  @@index([orderId])
  @@map("provision_jobs")
}

// ---------- 支付通道 ----------

model PayChannel {
  id                   BigInt   @id @default(autoincrement())
  code                 String   @unique @db.VarChar(48)
  name                 String   @db.VarChar(120)
  icon                 String?  @db.VarChar(32)
  driver               String   @db.VarChar(24) // jeepay | tokenpay
  wayCode              String?  @map("way_code") @db.VarChar(48)
  settleCurrency       String?  @map("settle_currency") @db.VarChar(16)
  // 顾客扫码时实际要输入的币种。面板按人民币计价、收款码是柬埔寨 ABA 这类
  // 情况下，顾客手里要付的是瑞尔，得按当日汇率折算给他看。留空表示和面板计价
  // 币种一致，不做任何折算。
  payCurrency          String?  @map("pay_currency") @db.VarChar(8)
  // 手工汇率（1 单位计价币 = 多少单位 payCurrency）。留空则用当日实时汇率。
  payRate              Float?   @map("pay_rate")
  // 折算后的金额是不是也照样报给网关。
  //
  // 默认关：只改给顾客看的数字，报给网关的还是原币种原金额。
  // 但如果网关是靠「等一笔金额对得上的钱」来销账的，两边报的数不一样就永远对不上 ——
  // 网关等着 1.00 元，顾客付的是 603 瑞尔，谁也等不到谁。这时候要打开。
  // 打开之后网关如果不认这个币种，下单会直接报错，关掉即可恢复。
  payCurrencyToGateway Boolean  @default(false) @map("pay_currency_to_gateway")
  gatewayUrl           String?  @map("gateway_url") @db.VarChar(255)
  credentialsEncrypted String   @map("credentials_encrypted") @db.Text
  rate                 Float?
  usdToCnyRate         Float?   @map("usd_to_cny_rate")
  isEnabled            Boolean  @default(true) @map("is_enabled")
  sortOrder            Int      @default(0) @map("sort_order")
  descText             String?  @map("desc_text") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("pay_channels")
}

/**
 * 汇率缓存。
 *
 * 只存最近一次拿到的值：汇率接口偶尔会抽风，抽风时宁可拿昨天的汇率
 * 标个「参考」给用户看，也不能因为取不到汇率就让人付不了款。
 */
model FxRate {
  id        BigInt   @id @default(autoincrement())
  base      String   @db.VarChar(8)
  quote     String   @db.VarChar(8)
  rate      Float
  source    String   @db.VarChar(32)
  asOf      DateTime @map("as_of")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([base, quote])
  @@map("fx_rates")
}

// ---------- 审计 ----------

model OperationLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    BigInt?  @map("actor_id")
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(32)
  targetId   BigInt?  @map("target_id")
  ip         String?  @db.VarChar(64)
  metaJson   Json?    @map("meta_json")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("operation_logs")
}


// ---------- NAT 入口 ----------

/**
 * NAT 网关：一台有公网 IP 的机器，替一堆没有公网 IP 的机器接客。
 *
 * 卖家自己家里 / 机房里的虚拟机跑在私网（比如 172.31.0.0/24），
 * 面板把它们的端口映射到这台网关的公网端口上，买家连网关就等于连到机器。
 * 网关和私网之间怎么通（Tailscale、WireGuard、还是同一个机房的二层）
 * 面板不关心，只要网关自己能路由到那个网段就行。
 */
model NatGateway {
  id   BigInt @id @default(autoincrement())
  name String @db.VarChar(64)

  /// 买家看到、也是买家去连的地址。可以是 IP，也可以是域名。
  publicHost String @map("public_host") @db.VarChar(128)

  /// 面板 SSH 上去下发 iptables 规则用的地址。通常和 publicHost 一样，
  /// 但网关藏在负载均衡后面时两者会不同，所以分开存。
  sshHost String @map("ssh_host") @db.VarChar(128)
  sshPort Int    @default(22) @map("ssh_port")
  sshUser String @default("root") @map("ssh_user")

  /// AES-256-GCM 密文。明文 { password?, privateKey? }
  authPayloadEncrypted String? @map("auth_payload_encrypted") @db.Text

  /// 私网网段，形如 172.31.0.0/24
  subnet String @db.VarChar(32)

  /// 可以拿来分配的公网端口区间（含两端）
  portStart Int @map("port_start")
  portEnd   Int @map("port_end")

  /// 每台机器分几个端口。第一个固定映射到机器的 22。
  portsPerMachine Int @default(20) @map("ports_per_machine")

  /// 送二级域名用的根域，比如 nat.renrenyings.net。
  /// 填了的话每台机器会拿到 m<SSH端口>.<这个域名>，由网关上的 Nginx
  /// 反代到机器的 80。留空就是不送域名，只给端口。
  webDomain String? @map("web_domain") @db.VarChar(128)

  enabled    Boolean   @default(true)
  lastSyncAt DateTime? @map("last_sync_at")
  lastError  String?   @map("last_error") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bindings NatBinding[]

  @@map("nat_gateways")
}

/// 一台机器占用的端口段。删机器时连带删掉，然后重新下发一次规则。
model NatBinding {
  id        BigInt @id @default(autoincrement())
  gatewayId BigInt @map("gateway_id")
  machineId BigInt @unique @map("machine_id")

  portStart Int @map("port_start")
  portEnd   Int @map("port_end")

  /// 映射到机器 22 端口的那个公网端口，取端口段的第一个
  sshPort Int @map("ssh_port")

  createdAt DateTime @default(now()) @map("created_at")

  gateway NatGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  machine Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, portStart])
  @@map("nat_bindings")
}


// ---------- 余额 ----------

enum WalletTxType {
  recharge // 充值到账
  consume // 下单扣款
  refund // 退回
  adjust // 管理员手工调整
}

enum RechargeStatus {
  pending_payment
  paid
  cancelled
  expired
}

/**
 * 余额流水。**只增不改不删**。
 *
 * 每一条都记着「这笔之后余额是多少」，所以任何时候都能拿最后一条
 * 跟 users.balance_cents 对一下 —— 对不上就说明有代码绕过了流水直接改余额，
 * 那是必须当场修的 bug。钱的事情不能只留一个当前值。
 */
model WalletTx {
  id     BigInt       @id @default(autoincrement())
  userId BigInt       @map("user_id")
  type   WalletTxType

  /// 正数入账，负数出账。单位分。
  amountCents Int @map("amount_cents")

  /// 这笔记账之后的余额，对账用
  balanceAfterCents Int @map("balance_after_cents")

  currency CurrencyCode @default(CNY)

  /// 关联单据：order / recharge / admin
  refType String? @map("ref_type") @db.VarChar(16)
  refNo   String? @map("ref_no") @db.VarChar(64)

  remark    String?  @db.VarChar(255)
  /// 管理员手工调整时记是谁调的
  operatorId BigInt? @map("operator_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, id])
  @@index([createdAt])
  @@map("wallet_txs")
}

/**
 * 充值单。
 *
 * 没有复用 orders 表：那张表上 plan_id / plan_price_id 都是必填的，
 * 为了充值把它们改成可空，会让「订单一定对应一个套餐」这个到处都在依赖的
 * 前提失效，得不偿失。充值单自己带支付字段，不用 payments 表。
 */
model RechargeOrder {
  id         BigInt @id @default(autoincrement())
  rechargeNo String @unique @map("recharge_no") @db.VarChar(64)
  userId     BigInt @map("user_id")

  amountCents Int          @map("amount_cents")
  currency    CurrencyCode @default(CNY)

  status RechargeStatus @default(pending_payment)

  payChannel String?   @map("pay_channel") @db.VarChar(32)
  upstreamNo String?   @map("upstream_no") @db.VarChar(64)
  // 最后一次提交给网关的商户单号（我们自己的单号 + 时间戳后缀）。
  // 不存下来就没法回头问网关「这笔到底收到没有」—— 回调丢了就只能人工对账。
  gatewayOrderNo String? @map("gateway_order_no") @db.VarChar(80)
  rawNotifyJson Json?  @map("raw_notify_json")
  paidAt     DateTime? @map("paid_at")
  expiresAt  DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("recharge_orders")
}

// ---------- USDT 收款 ----------

enum UsdtIntentStatus {
  pending
  paid
  expired
}

/**
 * 一笔等待中的 USDT 转账。
 *
 * 链上收款没有「商户订单号」这种东西 —— 转过来的就是一笔金额，
 * 没有任何字段能带上是谁转的。所以靠**金额唯一**来配对：
 * 给每笔待付款分配一个别人此刻没在用的精确金额（小数点后随机几位），
 * 看到链上有一笔正好这个数的转入，就认定是它。
 *
 * 这就要求同一个收款地址上，同一时刻不能有两笔待付款金额相同。
 */
model UsdtIntent {
  id       BigInt @id @default(autoincrement())
  intentNo String @unique @map("intent_no") @db.VarChar(64)

  /// order 或 recharge
  refType String @map("ref_type") @db.VarChar(16)
  refNo   String @map("ref_no") @db.VarChar(64)

  channelCode String @map("channel_code") @db.VarChar(48)
  address     String @db.VarChar(64)

  /// 要求转账的精确金额，单位是 USDT 的最小单位（1 USDT = 1000000）
  amountUnits BigInt @map("amount_units")

  /// 「这个地址上这个金额正被占用」的唯一键，形如 <地址>:<金额>。
  ///
  /// 只在 pending 时有值，结束后置 NULL。MySQL 的唯一索引允许多个 NULL，
  /// 所以历史记录不会互相冲突，而同一时刻同一地址上不可能出现两个相同金额。
  ///
  /// 光靠代码里「先查已占用的再挑一个」挡不住并发：两个请求同时读到同一份
  /// 已占用列表，就可能挑到同一个金额，然后一笔转账对上两张单 —— 其中一张
  /// 的用户付了钱永远等不到。这道约束是数据库层面的最后一道闸。
  activeKey String? @unique @map("active_key") @db.VarChar(96)

  /// 这笔订单原本的价钱，退款和对账时要看
  sourceAmountCents Int          @map("source_amount_cents")
  sourceCurrency    CurrencyCode @map("source_currency")

  status UsdtIntentStatus @default(pending)

  txId      String?   @map("tx_id") @db.VarChar(80)
  paidAt    DateTime? @map("paid_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, expiresAt])
  @@index([address, status])
  @@map("usdt_intents")
}
