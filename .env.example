# ============================================================
#  部署配置 —— 复制成 .env 之后按下面的说明填
#
#      cp .env.example .env
#      nano .env
#
#  下面每一项都写了「填什么」和「去哪拿」。带 ⚠️ 的必须改，
#  不改的话要么起不来，要么会被人攻破。
# ============================================================

# ---------- 域名 ----------
# ⚠️ 你的面板域名，不要带 https:// 也不要带斜杠。
#    填之前先确认：这个域名的 A 记录已经指向了这台服务器的公网 IP。
#    没做解析的话 HTTPS 证书申请不下来，网站打不开。
PANEL_DOMAIN=panel.example.com

# ⚠️ 你的邮箱。Let's Encrypt 用它在证书快过期时通知你（正常情况下不会收到邮件）。
ACME_EMAIL=you@example.com

# 网站名字，显示在浏览器标签和页面顶部
SITE_NAME=RenrenYings Cloud

# ---------- 密码和密钥 ----------
# 下面四项都要填随机字符串。生成办法（在服务器上执行）：
#
#     openssl rand -base64 36
#
# 每一项都单独生成一次，不要四个填一样的。

# ⚠️ 数据库 root 密码
MYSQL_ROOT_PASSWORD=

# ⚠️ 数据库业务账号密码
MYSQL_PASSWORD=

# ⚠️ 登录令牌签名密钥。泄露了别人就能伪造成任何用户登录。
JWT_SECRET=

# ⚠️ 凭据加密密钥，至少 32 位。
#    你的谷歌云密钥、AWS 密钥、每台机器的 root 密码都用它加密后才存进数据库。
#
#    ⚠️⚠️ 这一项一旦开始用就绝对不能改。改了之后所有已存的凭据全部解不开，
#         已经卖出去的机器面板就再也管不了了。填完请另外备份一份。
CREDENTIALS_SECRET=

# ---------- 管理员账号 ----------
# ⚠️ 第一次启动时自动创建的管理员账号，用它登录后台。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------- 花钱的闸门 ----------
# 「下单即开」是真花钱的：用户每买一台，你的云账单就多一台。
# 下面三项是防止有人恶意刷单把你账单刷爆的保险，建议保持开启。

# 单个用户最多能同时持有多少台在跑的机器
MAX_ACTIVE_SERVICES_PER_USER=5

# 全平台每天最多自动创建多少台机器
MAX_DAILY_PROVISION=50

# 未付款订单多少分钟后自动取消
ORDER_EXPIRE_MINUTES=30

# 无理由退货的时限，从机器交付那一刻算起（不是下单那一刻 ——
# 建机要花一两分钟，从下单算等于偷偷扣掉用户一截试用时间）。
# 窗口内用户可以自助退货：机器立刻销毁，货款退回账户余额。
# 设成 0 就是关掉这个功能。
REFUND_WINDOW_MINUTES=10

# ---------- 日志 ----------
# 排查建机失败时改成 debug，会打印每一次调用云厂商 API 的细节
LOG_LEVEL=log

# ---------- 余额与收款 ----------
# 账户余额的币种。只支持单币种 —— 见文档第 6 章 6.7 里为什么。
WALLET_CURRENCY=CNY
# 单笔充值的下限和上限（分）
RECHARGE_MIN_CENTS=100
RECHARGE_MAX_CENTS=1000000
# USDT 待付款保留多久（分钟）。超时后那个精确金额会被释放给下一位用。
USDT_EXPIRE_MINUTES=30
